# Agent Office settings. All optional: you can also set things in the web UI (gear icon).

# SWU AI (Srinakharinwirot University) gateway: main provider when set
SWU_API_KEY=
SWU_MODEL=anthropic/claude-sonnet-5.5

# Anthropic API key (also used for friends when no SWU key is set)
ANTHROPIC_API_KEY=

# Outside link for friends (needs cloudflared): 1 = open it automatically at start.
# You can also turn it on and off from the Share dialog.
# PUBLIC_TUNNEL=1
# A fixed address of your own instead (e.g. a named Cloudflare tunnel or a server domain)
# PUBLIC_URL=https://office.example.com
# CLOUDFLARED_BIN=/path/to/cloudflared
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_CODE_BIN=/path/to/claude
# PROJECTS_DIR=projects
# MAX_RUNNING_JOBS=3
# PORT=3000
