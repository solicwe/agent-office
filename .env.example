# Agent Office settings. All optional: you can also set things in the web UI (gear icon).

# SWU AI (Srinakharinwirot University) gateway: main provider when set
SWU_API_KEY=
SWU_MODEL=anthropic/claude-sonnet-5.5

# Anthropic API key (also used for friends when no SWU key is set)
ANTHROPIC_API_KEY=

# Token budget shown as "เหลือ X tokens"
# TOKEN_BUDGET=2000000
# Address friends open (e.g. a cloudflared tunnel URL)
# PUBLIC_URL=https://example.trycloudflare.com
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_CODE_BIN=/path/to/claude
# PROJECTS_DIR=projects
# MAX_RUNNING_JOBS=3
# PORT=3000
