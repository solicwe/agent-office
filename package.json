{
  "name": "agent-office",
  "version": "2.0.0",
  "description": "Markdown-defined agent roles for Claude Code, a local visual office that animates their work, and a hash-chained audit log",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify.js",
    "export-team": "node scripts/export-team.js",
    "attach": "node scripts/attach.js",
    "detach": "node scripts/attach.js --detach"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
